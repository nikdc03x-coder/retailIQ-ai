# Optional. Leave blank for local analytics and evidence-only answers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Per-request timeout in milliseconds; SDK retries are disabled to bound latency.
GEMINI_TIMEOUT_MS=15000
LOG_LEVEL=INFO
# Set RETAILIQ_HOME in the process environment (not here) for an external
# directory containing data/, reports/, models/, and an optional .env file.
